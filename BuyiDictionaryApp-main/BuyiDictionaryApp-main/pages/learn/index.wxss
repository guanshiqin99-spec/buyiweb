/* 单词卡学习页样式 */

.header-section {
  margin-bottom: 40rpx;
  text-align: center;
}
.learn-eyebrow {
  display: block;
  font-size: 24rpx;
  color: var(--color-primary);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}
.learn-title {
  display: block;
}

/* 学习统计条 */
.learn-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx 24rpx;
  margin-bottom: 32rpx;
}
.learn-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.learn-stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--color-primary);
  line-height: 1;
  margin-bottom: 8rpx;
}
.learn-stat-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.learn-stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: var(--color-card-border);
}

/* 状态卡 */
.status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 40rpx;
  text-align: center;
}
.status-card.empty {
  border-style: dashed;
  background: transparent;
  box-shadow: none;
}
.status-card.error {
  border-color: var(--color-error);
  background: var(--color-danger-bg);
}
.status-card .text-h3 {
  margin-bottom: 16rpx;
}

/* 进度条 */
.progress {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  margin-bottom: 32rpx;
}

/* 翻转卡片：3D 透视 + 翻面 */
.card-container {
  perspective: 1200rpx;
  width: 100%;
  margin-bottom: 40rpx;
}
.card-inner {
  position: relative;
  width: 100%;
  height: 440rpx;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.32, 0.72, 0, 1);
}
.card-inner.flipped {
  transform: rotateY(180deg);
}
.card-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: var(--radius-card-lg);
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-card);
}
.card-front {
  background: linear-gradient(160deg, rgba(255,255,255,0.96) 0%, rgba(238,244,255,0.96) 100%);
  border: 1px solid var(--color-card-border);
}
.card-back {
  transform: rotateY(180deg);
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  color: #fff;
  border: 1px solid var(--color-primary-dark);
}
.phonetic {
  font-size: 30rpx;
  color: var(--color-primary);
  font-family: monospace;
  margin-bottom: 16rpx;
}
.word {
  font-size: 76rpx;
  font-weight: bold;
  color: var(--color-primary-dark);
  letter-spacing: 2rpx;
  margin: 12rpx 0;
  word-break: break-all;
}
.hint {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 24rpx;
}
.card-back-title {
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
  word-break: break-all;
}
.english {
  font-size: 32rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 16rpx;
}
.card-back-phonetic {
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}

/* 底部四按钮 */
.action-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}
.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 12rpx;
  background: var(--color-card-bg);
  border: 1px solid var(--color-card-border);
  border-radius: var(--radius-card-sm);
  box-shadow: var(--shadow-light);
}
.action-btn:active {
  transform: scale(0.97);
}
.action-icon {
  font-size: 40rpx;
  color: var(--color-primary);
  line-height: 1;
  margin-bottom: 10rpx;
}
.action-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.action-btn-primary {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.action-btn-primary .action-icon,
.action-btn-primary .action-text {
  color: #fff;
}

/* 深色主题微调 */
.page.dark .card-front {
  background: linear-gradient(160deg, rgba(20,36,58,0.96) 0%, rgba(12,24,43,0.96) 100%);
}
.page.dark .word {
  color: var(--color-text-primary);
}
.page.dark .phonetic {
  color: var(--color-primary-light);
}
