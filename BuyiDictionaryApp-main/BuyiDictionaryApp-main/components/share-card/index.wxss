/* 成就分享卡导出组件样式：深蓝靛色主调 + 蜡染纹样 + 金色点缀 */

.share-card {
  position: relative;
}

/* 隐藏的离屏画布 */
.share-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}

/* 预览弹窗遮罩 */
.share-preview-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 预览弹窗主体 */
.share-preview-modal {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  width: 86%;
  max-width: 600rpx;
  box-sizing: border-box;
}

.share-preview-title {
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: #1e2c60;
}

.share-preview-image {
  width: 100%;
  height: 600rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}

.share-preview-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 按钮基础样式 */
.share-btn {
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  border: none;
  line-height: 1.4;
}

.share-btn::after {
  border: none;
}

/* 主按钮：深蓝靛色 */
.share-btn-primary {
  background: #1e2c60;
  color: #ffffff;
}

/* 次按钮：金色点缀 */
.share-btn-secondary {
  background: #c9a96e;
  color: #ffffff;
}

/* 幽灵按钮：取消 */
.share-btn-ghost {
  background: #f5f5f5;
  color: #666666;
}

/* 深色模式适配（跟随应用手动主题，非系统媒体查询） */
.page.dark .share-preview-modal {
  background: #1a2238;
}

.page.dark .share-preview-title {
  color: #e8eefc;
}

.page.dark .share-preview-image {
  background: #0f1c2e;
}

.page.dark .share-btn-ghost {
  background: #2a3450;
  color: #b8c4dc;
}
