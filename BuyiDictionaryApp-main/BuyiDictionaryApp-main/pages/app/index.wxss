/* ========== 页面基础 ========== */
.page {
  position: relative;
  min-height: 100vh;
  /* 白-青蓝水墨渐变背景 */
  background: var(--color-bg);
  color: var(--color-text-primary);
}

/* ========== 背景层 ========== */
.home-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 620rpx;
  background: linear-gradient(180deg, #E6F0FF 0%, #F4F8FF 80%, rgba(244, 248, 255, 0) 100%);
  z-index: 0;
}

.page.dark .home-hero-bg {
  background: linear-gradient(180deg, rgba(22, 100, 217, 0.15) 0%, rgba(10, 24, 43, 0.3) 80%, rgba(10, 24, 43, 0) 100%);
}

.bg-cloud {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  background-image:
    radial-gradient(ellipse at 85% 95%, rgba(22, 100, 217, 0.15) 0%, rgba(22, 100, 217, 0) 40%),
    radial-gradient(ellipse at 15% 100%, rgba(87, 140, 199, 0.18) 0%, rgba(87, 140, 199, 0) 45%),
    radial-gradient(circle at 90% 10%, rgba(35, 85, 167, 0.05) 0%, rgba(35, 85, 167, 0) 40%),
    radial-gradient(circle at 10% 20%, rgba(35, 85, 167, 0.03) 0%, rgba(35, 85, 167, 0) 30%);
  opacity: 0.9;
  z-index: 0;
}

.page.dark .bg-cloud {
  background-image:
    radial-gradient(ellipse at 85% 95%, rgba(22, 100, 217, 0.08) 0%, rgba(22, 100, 217, 0) 40%),
    radial-gradient(ellipse at 15% 100%, rgba(87, 140, 199, 0.1) 0%, rgba(87, 140, 199, 0) 45%);
}

.page-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

.app-scroll {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  padding: 0 28rpx 0;
}

/* ========== 头部 ========== */
.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 42rpx;
  padding: 28rpx 0 30rpx;
  animation: rise-in 0.5s ease backwards;
}

.hero-kicker,
.hero-title,
.hero-desc {
  position: relative;
}

.hero-kicker {
  align-self: flex-start;
  padding: 8rpx 22rpx;
  border: 1rpx solid rgba(22, 100, 217, 0.26);
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: var(--color-text-secondary);
}

.hero-title {
  align-self: flex-start;
  margin-top: 10rpx;
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--color-primary-dark);
  font-family: "STZhongsong", "SimSun", serif;
}

/* 标题下的朱砂笔触 */
.hero-title::after {
  content: '';
  display: block;
  width: 138rpx;
  height: 8rpx;
  margin-top: 12rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, rgba(194, 69, 45, 0.72), rgba(194, 69, 45, 0));
}

.hero-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* 朱砂印章 */
.hero-seal {
  position: absolute;
  top: 30rpx;
  right: 8rpx;
  width: 92rpx;
  height: 92rpx;
  background: linear-gradient(150deg, #CD5A40 0%, #B93E28 100%);
  border-radius: 14rpx;
  transform: rotate(6deg);
  box-shadow: 0 12rpx 26rpx rgba(185, 62, 40, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.hero-seal::after {
  content: '';
  position: absolute;
  inset: 6rpx;
  border: 2rpx solid rgba(255, 246, 238, 0.55);
  border-radius: 9rpx;
}

.seal-char {
  font-size: 32rpx;
  line-height: 1.15;
  color: #FFF6EE;
  font-family: "STZhongsong", "SimSun", serif;
  font-weight: 700;
}

/* ========== 功能卡片 ========== */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 26rpx;
}

.feature-card {
  /* 默认青色，各入口通过修饰类覆盖 */
  --accent: #1664D9;
  --accent-deep: #12489E;
  --accent-bg: #F1F5FD;
  --accent-line: rgba(22, 100, 217, 0.32);

  display: flex;
  flex-direction: column;
  min-height: 284rpx;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(172deg, #FFFFFF 0%, var(--accent-bg) 100%);
  border: 1rpx solid rgba(135, 181, 234, 0.3);
  box-shadow: 0 18rpx 40rpx rgba(45, 100, 176, 0.08);
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  transition: transform 0.18s ease, box-shadow 0.25s ease;
  animation: card-in 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) backwards;
}

/* 卡片顶部色条 */
.feature-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 30rpx;
  width: 76rpx;
  height: 5rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: linear-gradient(90deg, var(--accent), transparent);
  z-index: 1;
}

/* 背景水印大字 */
.feature-card::after {
  content: '';
  position: absolute;
  right: -18rpx;
  bottom: -40rpx;
  font-family: "STZhongsong", "SimSun", serif;
  font-size: 200rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--accent);
  opacity: 0.055;
  transform: rotate(-8deg);
  z-index: 0;
  pointer-events: none;
}

/* 按压反馈 */
.card-pressed {
  transform: scale(0.965);
  box-shadow: 0 8rpx 20rpx rgba(45, 100, 176, 0.12);
}

/* 水印字已统一为空，不再区分入口 */

.feature-top,
.feature-title,
.feature-desc {
  position: relative;
  z-index: 1;
}

.feature-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.feature-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: var(--accent-bg);
  border: 2rpx dashed var(--accent-line);
  color: var(--accent-deep);
  font-size: 42rpx;
  font-family: "STZhongsong", "SimSun", serif;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.feature-icon::after {
  content: '';
  position: absolute;
  top: -7rpx;
  left: -7rpx;
  right: -7rpx;
  bottom: -7rpx;
  border-radius: 50%;
  border: 1rpx solid var(--accent-line);
  opacity: 0.6;
}

.feature-arrow {
  font-size: 38rpx;
  font-weight: 300;
  color: var(--accent);
  opacity: 0.65;
}

.feature-title {
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--accent-deep);
}

.feature-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

/* ========== 学习顺序指引 ========== */
.guide-panel {
  margin-top: 32rpx;
  padding: 40rpx 32rpx 34rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 249, 255, 0.95) 100%);
  border: 1rpx solid rgba(167, 207, 255, 0.3);
  box-shadow: 0 16rpx 32rpx rgba(45, 100, 176, 0.05);
  position: relative;
  overflow: hidden;
  animation: rise-in 0.6s ease 0.45s backwards;
}

/* 宣纸格纹 */
.guide-panel::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    linear-gradient(90deg, rgba(22, 100, 217, 0.02) 1px, transparent 1px),
    linear-gradient(rgba(22, 100, 217, 0.02) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
  pointer-events: none;
}

.guide-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  font-family: "STZhongsong", "SimSun", serif;
  position: relative;
  z-index: 1;
}

.guide-title::before {
  content: '☁';
  margin-right: 12rpx;
  color: var(--color-primary-light);
  font-size: 28rpx;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}

.guide-item {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed rgba(22, 100, 217, 0.1);
}

.guide-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.guide-index {
  min-width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: transparent;
  border: 2rpx solid var(--color-primary-dark);
  color: var(--color-primary-dark);
  font-size: 24rpx;
  font-weight: bold;
  font-family: "STZhongsong", "SimSun", serif;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.guide-index::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(18, 59, 107, 0.3);
}

.guide-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
  padding-top: 6rpx;
}

.guide-footnote {
  display: block;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed rgba(22, 100, 217, 0.14);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--color-text-secondary);
  text-align: right;
  position: relative;
  z-index: 1;
}

.bottom-safe {
  height: 180rpx;
}

/* ========== 入场动画 ========== */
@keyframes card-in {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* ========== 深色模式 ========== */
.dark.page {
  background: linear-gradient(180deg, #071525 0%, #0b1d33 42%, #10243e 100%);
  color: #eaf3ff;
}

.dark .page-bg {
  background-image:
    radial-gradient(circle at 50% -10%, rgba(220, 235, 255, 0.08) 0%, rgba(220, 235, 255, 0.02) 18%, rgba(220, 235, 255, 0) 34%),
    radial-gradient(ellipse at 18% 16%, rgba(49, 95, 175, 0.2) 0%, rgba(49, 95, 175, 0.05) 28%, rgba(49, 95, 175, 0) 56%),
    radial-gradient(ellipse at 84% 22%, rgba(87, 140, 199, 0.18) 0%, rgba(87, 140, 199, 0.04) 30%, rgba(87, 140, 199, 0) 58%);
}

.dark .hero-kicker {
  border-color: rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.04);
  color: #9fb8d8;
}

.dark .hero-title {
  color: #edf5ff;
}

.dark .hero-desc {
  color: #9fb8d8;
}

.dark .feature-card {
  background: linear-gradient(172deg, rgba(16, 33, 56, 0.98) 0%, var(--accent-bg) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.35);
}

.dark .feature-card::after {
  opacity: 0.09;
}

.dark .card-pressed {
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.5);
}

.dark .feature-card {
  --accent: #7FB0F7;
  --accent-deep: #BDD7FA;
  --accent-bg: #1E324E;
  --accent-line: rgba(127, 176, 247, 0.3);
}

.dark .feature-desc {
  color: #9fb8d8;
}

.dark .guide-panel {
  background: linear-gradient(180deg, rgba(14, 30, 52, 0.98) 0%, rgba(10, 24, 43, 0.95) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.4);
}

.dark .guide-title {
  color: #edf5ff;
}

.dark .guide-item {
  border-bottom: 1rpx dashed rgba(255, 255, 255, 0.1);
}

.dark .guide-index {
  border-color: #EDF5FF;
  color: #EDF5FF;
}

.dark .guide-index::after {
  border: 2rpx dashed rgba(255, 255, 255, 0.3);
}

.dark .guide-text {
  color: #9fb8d8;
}

.dark .guide-footnote {
  border-top-color: rgba(255, 255, 255, 0.1);
  color: #9fb8d8;
}
