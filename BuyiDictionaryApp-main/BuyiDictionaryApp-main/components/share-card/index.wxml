<!-- 成就分享卡导出组件：隐藏 canvas 离屏绘制 + 预览弹窗 -->
<view class="share-card">
  <!-- 隐藏的画布，用于离屏绘制 -->
  <canvas type="2d" id="shareCanvas" class="share-canvas-hidden" style="width:300px;height:400px;"></canvas>

  <!-- 预览弹窗 -->
  <view wx:if="{{previewVisible}}" class="share-preview-overlay" bindtap="onPreviewClose">
    <view class="share-preview-modal" catchtap="">
      <view class="share-preview-title">成就分享卡预览</view>
      <image src="{{tempFilePath}}" mode="aspectFit" class="share-preview-image" />
      <view class="share-preview-actions">
        <button class="share-btn share-btn-primary" bindtap="onSaveToAlbum">保存到相册</button>
        <button class="share-btn share-btn-secondary" open-type="share" bindtap="onShareToFriend">转发给好友</button>
        <button class="share-btn share-btn-ghost" bindtap="onPreviewClose">取消</button>
      </view>
    </view>
  </view>
</view>
