/* 播放详情页 · 蜡染留声机 */

.player-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #fff;
}

/* 模糊背景图 */
.bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: blur(40rpx);
  transform: scale(1.1);
  z-index: 0;
}

/* 背景遮罩：青花蓝沉浸 + 蜡染光晕 */
.bg-mask {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    radial-gradient(circle at 80% 20%, rgba(224, 168, 90, 0.06) 0%, transparent 40%),
    radial-gradient(circle at 15% 75%, rgba(90, 169, 255, 0.08) 0%, transparent 35%),
    linear-gradient(180deg, rgba(11, 42, 74, 0.85) 0%, rgba(18, 59, 107, 0.92) 100%);
}

/* 内容容器 */
.content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  min-height: 100vh;
  padding: 80rpx 40rpx 0;
  box-sizing: border-box;
}

/* —— 顶部信息 —— */
.top {
  width: 100%;
  text-align: center;
  margin-top: 40rpx;
}
.now-playing {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E0A85A;
  box-shadow: 0 0 0 0 rgba(224, 168, 90, 0.6);
  opacity: 0.5;
  transition: opacity 300ms ease;
}
.now-playing.is-playing .pulse-dot {
  opacity: 1;
  animation: pulse 1.8s ease-out infinite;
}
.now-playing-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
}
.song-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 16rpx;
}
.artist-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
}
.song-artist {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* —— 黑胶唱片 —— */
.cover-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}
.cover-border {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    repeating-radial-gradient(circle at center, transparent 0 3rpx, rgba(255, 255, 255, 0.04) 3rpx 4rpx),
    radial-gradient(circle at center, #2a2d33 0%, #15171c 80%);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.18), 0 32rpx 64rpx rgba(0, 0, 0, 0.4);
  transition: box-shadow 400ms ease;
}
.cover-border.is-playing {
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.18), 0 32rpx 64rpx rgba(0, 0, 0, 0.4), 0 0 60rpx rgba(90, 169, 255, 0.25);
}
.cover {
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  filter: grayscale(0.2) brightness(0.85);
  transition: filter 400ms ease, animation-play-state 200ms;
}
.cover.spin {
  animation: spin 12s linear infinite;
  animation-play-state: paused;
}
.cover-border.is-playing .cover.spin {
  animation-play-state: running;
  filter: none;
}
.disc-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #E0A85A;
  box-shadow: 0 0 8rpx rgba(224, 168, 90, 0.6);
  z-index: 3;
}

/* —— 歌词玻璃卡 —— */
.lyric-box {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 36rpx;
  margin-bottom: 40rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
}
.lyric-text {
  display: block;
  font-size: 32rpx;
  line-height: 1.6;
  color: #E0A85A;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}
.lyric-text--cn {
  color: rgba(255, 255, 255, 0.78);
}

/* —— 控制区 —— */
.controls {
  width: 100%;
  box-sizing: border-box;
  padding: 0 20rpx calc(40rpx + env(safe-area-inset-bottom));
}
.progress {
  margin: 0;
}
.time-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-variant-numeric: tabular-nums;
  margin-top: -8rpx;
  margin-bottom: 40rpx;
}
.btn-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 60rpx;
}
.ctrl-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  color: #fff;
  transition: transform 0.2s ease;
}
.ctrl-btn:active {
  transform: scale(0.9);
}
.sub-btn {
  width: 96rpx;
  height: 96rpx;
  font-size: 40rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}
.play-btn {
  width: 144rpx;
  height: 144rpx;
  font-size: 64rpx;
  background: #1664D9;
  color: #fff;
  border: 4rpx solid rgba(224, 168, 90, 0.5);
  box-shadow: 0 0 24rpx rgba(224, 168, 90, 0.4), 0 16rpx 32rpx rgba(0, 0, 0, 0.3);
}

/* —— 动画 —— */
@keyframes spin {
  from { transform: rotate(0); }
  to { transform: rotate(360deg); }
}
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(224, 168, 90, 0.6); }
  70% { box-shadow: 0 0 0 16rpx rgba(224, 168, 90, 0); }
  100% { box-shadow: 0 0 0 0 rgba(224, 168, 90, 0); }
}

/* —— 深色模式覆盖 —— */
.page.dark.player-page {
  color: #fff;
}
.page.dark .bg-mask {
  background:
    radial-gradient(circle at 80% 20%, rgba(224, 168, 90, 0.03) 0%, transparent 40%),
    radial-gradient(circle at 15% 75%, rgba(90, 169, 255, 0.04) 0%, transparent 35%),
    linear-gradient(180deg, rgba(8, 22, 39, 0.92) 0%, rgba(11, 42, 74, 0.95) 100%);
}
.page.dark .cover-border {
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.18), 0 32rpx 64rpx rgba(0, 0, 0, 0.5);
}
.page.dark .cover-border.is-playing {
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.18), 0 32rpx 64rpx rgba(0, 0, 0, 0.5), 0 0 60rpx rgba(90, 169, 255, 0.2);
}
.page.dark .sub-btn {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.2);
}
.page.dark .lyric-box {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.15);
}
.page.dark .song-title {
  color: #fff;
}

/* —— 无障碍：减弱动效 —— */
@media (prefers-reduced-motion: reduce) {
  .cover.spin,
  .cover-border.is-playing .cover.spin {
    animation: none !important;
  }
  .pulse-dot,
  .now-playing.is-playing .pulse-dot {
    animation: none !important;
  }
}
