/* 发音闯关页：开场界面「青花声纹 · 朱砂启关」，答题/成绩阶段对齐文化答题页（quiz） */
.pronunciation-page { padding-bottom: 96rpx; }
.abandon-bar {
  padding: 16rpx 32rpx;
  display: flex;
  justify-content: flex-end;
}
.abandon-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-capsule);
}

/* ========== 开场介绍 ========== */
.pron-intro {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 24rpx 0 40rpx;
}

/* 瓷盘弧线背景装饰 */
.intro-deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.intro-deco.arc-a {
  width: 430rpx;
  height: 430rpx;
  top: -110rpx;
  right: -150rpx;
  border: 2rpx solid rgba(22, 100, 217, 0.1);
}
.intro-deco.arc-b {
  width: 300rpx;
  height: 300rpx;
  left: -150rpx;
  bottom: 300rpx;
  border: 2rpx dashed rgba(22, 100, 217, 0.09);
}

.intro-hero {
  position: relative;
  padding: 34rpx 0 6rpx;
  margin-bottom: 6rpx;
  animation: pron-rise 0.5s ease backwards;
}

.intro-kicker {
  display: inline-flex;
  align-self: flex-start;
  padding: 8rpx 22rpx;
  border: 1rpx solid rgba(22, 100, 217, 0.26);
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: inset 0 0 0 5rpx rgba(22, 100, 217, 0.05);
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: var(--color-text-secondary);
}

.hero-title-row {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-top: 20rpx;
}

.intro-title { display: flex; }

/* 标题逐字入场 */
.t-char {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  font-family: "STZhongsong", "SimSun", serif;
  animation: char-drop 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) backwards;
}
.t-char.c1 { animation-delay: 0.04s; }
.t-char.c2 { animation-delay: 0.09s; }
.t-char.c3 { animation-delay: 0.14s; }
.t-char.c4 { animation-delay: 0.19s; }
.t-char.c5 { animation-delay: 0.24s; }

@keyframes char-drop {
  from { opacity: 0; transform: translateY(28rpx) scale(0.96); }
  to { opacity: 1; transform: none; }
}

/* 标题右侧声波律动 */
.voice-marks {
  display: flex;
  align-items: center;
  gap: 7rpx;
  height: 56rpx;
}

.voice-bar {
  width: 9rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, var(--color-primary-light), var(--color-primary));
  box-shadow: 0 0 10rpx rgba(90, 169, 255, 0.35);
  transform-origin: center;
  animation: voice-wave 1.15s ease-in-out infinite;
}

.voice-bar.v1 { height: 20rpx; animation-delay: 0s; }
.voice-bar.v2 { height: 38rpx; animation-delay: 0.1s; }
.voice-bar.v3 { height: 54rpx; animation-delay: 0.2s; }
.voice-bar.v4 { height: 30rpx; animation-delay: 0.3s; }
.voice-bar.v5 { height: 46rpx; animation-delay: 0.4s; }
.voice-bar.v6 { height: 24rpx; animation-delay: 0.5s; }

@keyframes voice-wave {
  0%, 100% { transform: scaleY(0.5); opacity: 0.7; }
  50% { transform: scaleY(1); opacity: 1; }
}

/* 标题下的朱砂笔触 */
.title-stroke {
  width: 132rpx;
  height: 8rpx;
  margin-top: 14rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, rgba(194, 69, 45, 0.72), rgba(194, 69, 45, 0));
}

.intro-desc {
  display: block;
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
}

/* ========== 声纹徽章 ========== */
.voice-emblem-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 10rpx;
  animation: pron-rise 0.5s ease 0.1s backwards;
}

.voice-emblem {
  position: relative;
  width: 320rpx;
  height: 320rpx;
}

/* 涟漪声波：三环错峰外扩 */
.emblem-ripple {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(90, 169, 255, 0.38);
  animation: ripple-out 2.4s ease-out infinite;
}
.emblem-ripple.r1 { animation-delay: 0s; }
.emblem-ripple.r2 { animation-delay: 0.8s; }
.emblem-ripple.r3 { animation-delay: 1.6s; }

@keyframes ripple-out {
  0% { transform: scale(0.74); opacity: 0; }
  14% { opacity: 0.55; }
  100% { transform: scale(1.16); opacity: 0; }
}

/* 青花描边圆环（虚线，似瓷盘沿） */
.emblem-ring {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(22, 100, 217, 0.34);
}

/* 环上运行的朱砂点与釉蓝点 */
.orbit {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  border-radius: 50%;
  animation: orbit-spin 16s linear infinite;
}
.orbit.o2 { animation-duration: 22s; animation-direction: reverse; }

.orbit-dot {
  position: absolute;
  top: -6rpx;
  left: 50%;
  margin-left: -6rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C2452D;
  box-shadow: 0 0 12rpx rgba(194, 69, 45, 0.55);
}
.orbit-dot.alt {
  top: auto;
  bottom: -5rpx;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  background: #5AA9FF;
  box-shadow: 0 0 12rpx rgba(90, 169, 255, 0.6);
}

@keyframes orbit-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 中心青花瓷印 */
.emblem-core {
  position: absolute;
  top: 64rpx;
  right: 64rpx;
  bottom: 64rpx;
  left: 64rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #1E6FE3 0%, #1664D9 44%, #0F4FA8 100%);
  box-shadow: 0 20rpx 44rpx rgba(22, 100, 217, 0.32), inset 0 2rpx 8rpx rgba(255, 255, 255, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.emblem-char {
  font-size: 84rpx;
  font-weight: 700;
  line-height: 1;
  color: #F5FAFF;
  font-family: "STZhongsong", "SimSun", serif;
  text-shadow: 0 4rpx 14rpx rgba(6, 40, 90, 0.4);
}

/* 印心白色声波 */
.emblem-wave {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 26rpx;
}
.ew-bar {
  width: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  transform-origin: center;
  animation: voice-wave 1.1s ease-in-out infinite;
}
.ew-bar.b1 { height: 12rpx; animation-delay: 0s; }
.ew-bar.b2 { height: 22rpx; animation-delay: 0.12s; }
.ew-bar.b3 { height: 28rpx; animation-delay: 0.24s; }
.ew-bar.b4 { height: 20rpx; animation-delay: 0.36s; }
.ew-bar.b5 { height: 12rpx; animation-delay: 0.48s; }

/* 徽章右侧竖排小签 */
.emblem-side-label {
  position: absolute;
  right: -78rpx;
  top: 50%;
  transform: translateY(-50%);
  writing-mode: vertical-rl;
  padding-left: 14rpx;
  border-left: 1rpx solid rgba(22, 100, 217, 0.22);
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: var(--color-text-secondary);
}

/* 徽章下题跋 */
.emblem-caption {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}
.caption-line {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(22, 100, 217, 0), rgba(22, 100, 217, 0.45));
}
.caption-line.flip {
  background: linear-gradient(90deg, rgba(22, 100, 217, 0.45), rgba(22, 100, 217, 0));
}
.caption-text {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--color-text-secondary);
}

/* ========== 玩法三步：看 → 读 → 评 ========== */
.intro-steps {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin-top: 26rpx;
  padding: 30rpx 20rpx 26rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx dashed rgba(22, 100, 217, 0.22);
  animation: pron-rise 0.5s ease 0.16s backwards;
}

.step-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.step-char {
  width: 62rpx;
  height: 62rpx;
  border-radius: 31rpx;
  border: 2rpx dashed rgba(22, 100, 217, 0.4);
  color: var(--color-primary-dark);
  font-size: 28rpx;
  font-weight: 700;
  font-family: "STZhongsong", "SimSun", serif;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-char-hot {
  border: 2rpx solid transparent;
  background: linear-gradient(150deg, #2F8F6E 0%, #236B52 100%);
  color: #F2F8F6;
  box-shadow: 0 10rpx 22rpx rgba(47, 143, 110, 0.28);
}

.step-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 连接虚线 + 青花菱形 */
.step-sep {
  flex: 0 0 64rpx;
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}
.step-sep::before {
  content: "";
  flex: 1;
  border-top: 2rpx dashed rgba(92, 134, 197, 0.4);
}
.step-sep::after {
  content: "";
  width: 10rpx;
  height: 10rpx;
  margin-left: 8rpx;
  transform: rotate(45deg);
  background: rgba(22, 100, 217, 0.32);
}

/* ========== 规则速览：一瓷三分 ========== */
.intro-stats {
  position: relative;
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  padding: 26rpx 10rpx 22rpx;
  border-radius: 22rpx;
  background: var(--color-card-bg);
  border: 1rpx solid var(--color-card-border);
  box-shadow: 0 12rpx 26rpx rgba(45, 100, 176, 0.06);
  animation: pron-rise 0.5s ease 0.22s backwards;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--color-primary-dark);
  font-family: "STZhongsong", "SimSun", serif;
}

.stat-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--color-text-secondary);
}

.stat-divider {
  width: 1rpx;
  margin: 6rpx 0;
  background: linear-gradient(180deg, rgba(22, 100, 217, 0), rgba(22, 100, 217, 0.2), rgba(22, 100, 217, 0));
}

/* ========== 最近成绩 ========== */
.last-attempt-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: rgba(22, 100, 217, 0.06);
  border: 1rpx dashed rgba(22, 100, 217, 0.28);
  animation: pron-rise 0.5s ease 0.26s backwards;
}

.last-attempt-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(22, 100, 217, 0.12);
  animation: dot-pulse 2s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes dot-pulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(22, 100, 217, 0.12); }
  50% { box-shadow: 0 0 0 11rpx rgba(22, 100, 217, 0.04); }
}

.last-attempt-text {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--color-primary-dark);
}

/* ========== 插件不可用提示 ========== */
.plugin-warning {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: rgba(245, 158, 11, 0.08);
  border: 1rpx solid rgba(245, 158, 11, 0.32);
  animation: pron-rise 0.5s ease 0.26s backwards;
}

.plugin-warning-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: var(--color-warning);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.plugin-warning-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.6;
  color: #8a5a10;
}

/* ========== 开始按钮与提示 ========== */
.pron-start-btn {
  position: relative;
  overflow: hidden;
  margin-top: 34rpx;
  height: 100rpx;
  gap: 14rpx;
  background: linear-gradient(135deg, #2F7BE0 0%, #1664D9 46%, #0E4C9E 100%);
  box-shadow: 0 16rpx 34rpx rgba(22, 100, 217, 0.32), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.24);
  transition: transform 150ms ease, box-shadow 150ms ease;
  animation: pron-rise 0.5s ease 0.3s backwards;
}

.pron-start-btn[disabled] { opacity: 0.85; }

/* 釉面流光 */
.start-sheen {
  position: absolute;
  top: -20%;
  left: -70%;
  width: 42%;
  height: 140%;
  background: linear-gradient(105deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0));
  transform: skewX(-18deg);
  animation: sheen-sweep 3.2s ease-in-out infinite;
  pointer-events: none;
}

@keyframes sheen-sweep {
  0%, 58% { left: -70%; }
  100% { left: 135%; }
}

/* 按钮内白色声波 */
.start-voice {
  display: flex;
  align-items: center;
  gap: 5rpx;
  height: 34rpx;
}
.sv-bar {
  width: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  transform-origin: center;
  animation: voice-wave 1.15s ease-in-out infinite;
}
.sv-bar.b1 { height: 14rpx; animation-delay: 0s; }
.sv-bar.b2 { height: 26rpx; animation-delay: 0.15s; }
.sv-bar.b3 { height: 18rpx; animation-delay: 0.3s; }

.start-btn-label {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.start-pressed {
  transform: scale(0.975);
  box-shadow: 0 8rpx 20rpx rgba(22, 100, 217, 0.26), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
}

.pron-start-hint {
  position: relative;
  margin-top: 18rpx;
  text-align: center;
  font-size: 23rpx;
  letter-spacing: 1rpx;
  color: var(--color-text-secondary);
  animation: pron-rise 0.5s ease 0.34s backwards;
}

@keyframes pron-rise {
  from { opacity: 0; transform: translateY(22rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ========== 成绩汇总 ========== */
.pronunciation-result { display: flex; flex-direction: column; align-items: center; gap: 24rpx; padding: 48rpx 36rpx; text-align: center; }
.primary-text { color: var(--color-primary); }
.score-value { color: var(--color-primary-dark); font-size: 112rpx; font-weight: 700; line-height: 1; }
.save-message { min-height: 44rpx; line-height: 1.6; }

.quiz-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.progress-track { height: 8rpx; margin-bottom: 28rpx; overflow: hidden; border-radius: 999rpx; background: rgba(92, 134, 197, .16); }
.progress-bar { height: 100%; border-radius: inherit; background: var(--color-primary); transition: width 220ms ease; }

.question-card { padding: 36rpx 28rpx; }
.question-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 24rpx; }
.kind-tag { flex-shrink: 0; }
.audio-btn { height: 64rpx; min-height: 64rpx; padding: 0 28rpx; margin: 0; font-size: 26rpx; font-weight: 600; border-radius: var(--radius-capsule); }
.buyi-text { display: block; margin-bottom: 14rpx; line-height: 1.4; font-size: 60rpx; letter-spacing: 2rpx; color: var(--color-primary-dark); }
.zh-text { display: block; margin-bottom: 10rpx; color: var(--color-text-primary); }
.desc-text { display: block; line-height: 1.7; }

/* 按住跟读区域 */
.record-area { display: flex; flex-direction: column; align-items: stretch; gap: 18rpx; margin-top: 30rpx; padding-top: 28rpx; border-top: 2rpx solid rgba(92, 134, 197, .14); }
.record-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 176rpx;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(22, 100, 217, 0.45);
  background: rgba(22, 100, 217, 0.06);
  transition: background 200ms ease, border-color 200ms ease;
}
.record-btn-text { font-size: 34rpx; font-weight: 700; color: var(--color-primary); }
.record-btn-sub { font-size: 24rpx; color: var(--color-text-secondary); }
.record-btn.recording { border-color: var(--color-error); background: rgba(217, 83, 79, 0.08); }
.record-btn.recording .record-btn-text { color: var(--color-error); }
.record-btn.evaluating { border-style: solid; border-color: rgba(22, 100, 217, 0.3); background: rgba(22, 100, 217, 0.04); }
.record-btn.record-disabled { border-color: var(--color-card-border); background: rgba(148, 163, 184, 0.08); }
.record-btn.record-disabled .record-btn-text { color: var(--color-text-secondary); }
.transient-box { padding: 18rpx 24rpx; border-radius: 18rpx; background: rgba(92, 134, 197, .1); }
.transient-text { line-height: 1.6; word-break: break-all; }
.plugin-tip { color: var(--color-warning); line-height: 1.6; }
.recognize-error { color: var(--color-error); line-height: 1.6; }

/* 评分结果 */
.pronunciation-feedback { display: flex; flex-direction: column; gap: 18rpx; margin-top: 30rpx; padding-top: 28rpx; border-top: 2rpx solid rgba(92, 134, 197, .14); }
.result-head { display: flex; align-items: center; gap: 20rpx; }
.score-badge { font-size: 56rpx; font-weight: 700; line-height: 1.1; color: var(--color-primary-dark); }
.points-badge { padding: 8rpx 22rpx; border-radius: var(--radius-capsule); font-size: 26rpx; font-weight: 600; }
.points-badge.passed { color: #176238; background: #e8f6ed; }
.points-badge.failed { color: #8b2f2f; background: #faeaea; }
.feedback-text { line-height: 1.7; }
.syllable-section { display: flex; flex-direction: column; gap: 12rpx; padding: 20rpx 24rpx; border-radius: 18rpx; background: rgba(92, 134, 197, .08); }
.syllable-label { font-weight: 600; }
.syllable-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.syllable {
  min-width: 56rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #173B6C;
}
.syllable.match { color: #176238; background: #e8f6ed; border: 1rpx solid #2f8f57; }
.syllable.diff { color: #8b2f2f; background: #f1f3f6; border: 1rpx solid #c65b5b; }
.recognized-text { line-height: 1.6; word-break: break-all; }
.result-actions { display: flex; gap: 20rpx; margin-top: 6rpx; }
.result-actions .btn { flex: 1; }

/* ========== 深色模式（开场介绍） ========== */
.dark .intro-deco.arc-a { border-color: rgba(127, 176, 247, 0.12); }
.dark .intro-deco.arc-b { border-color: rgba(127, 176, 247, 0.1); }

.dark .intro-kicker {
  border-color: rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.04);
  box-shadow: inset 0 0 0 5rpx rgba(255, 255, 255, 0.03);
}

.dark .t-char { color: #edf5ff; }

.dark .intro-desc { color: #9fb8d8; }

.dark .emblem-ripple { border-color: rgba(90, 169, 255, 0.3); }
.dark .emblem-ring { border-color: rgba(127, 176, 247, 0.32); }

.dark .emblem-core {
  background: linear-gradient(160deg, #1C5FBE 0%, #14498F 50%, #0C3570 100%);
  box-shadow: 0 20rpx 44rpx rgba(0, 0, 0, 0.5), inset 0 2rpx 8rpx rgba(255, 255, 255, 0.14);
}

.dark .emblem-side-label {
  color: #9fb8d8;
  border-color: rgba(127, 176, 247, 0.25);
}

.dark .caption-line { background: linear-gradient(90deg, rgba(127, 176, 247, 0), rgba(127, 176, 247, 0.45)); }
.dark .caption-line.flip { background: linear-gradient(90deg, rgba(127, 176, 247, 0.45), rgba(127, 176, 247, 0)); }
.dark .caption-text { color: #9fb8d8; }

.dark .intro-steps {
  background: rgba(10, 24, 43, 0.6);
  border-color: rgba(127, 176, 247, 0.3);
}

.dark .step-char {
  color: #bdd7fa;
  border-color: rgba(127, 176, 247, 0.4);
}

.dark .step-label { color: #9fb8d8; }
.dark .step-sep::before { border-color: rgba(127, 176, 247, 0.32); }
.dark .step-sep::after { background: rgba(127, 176, 247, 0.38); }

.dark .intro-stats {
  background: rgba(10, 24, 43, 0.9);
  border-color: rgba(255, 255, 255, 0.08);
}

.dark .stat-num { color: #edf5ff; }
.dark .stat-label { color: #9fb8d8; }
.dark .stat-divider { background: linear-gradient(180deg, rgba(127, 176, 247, 0), rgba(127, 176, 247, 0.24), rgba(127, 176, 247, 0)); }

.dark .last-attempt-card {
  background: rgba(90, 169, 255, 0.08);
  border-color: rgba(90, 169, 255, 0.3);
}

.dark .last-attempt-dot {
  box-shadow: 0 0 0 6rpx rgba(90, 169, 255, 0.14);
  animation: dot-pulse-dark 2s ease-in-out infinite;
}

@keyframes dot-pulse-dark {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(90, 169, 255, 0.14); }
  50% { box-shadow: 0 0 0 11rpx rgba(90, 169, 255, 0.05); }
}

.dark .last-attempt-text { color: #bdd7fa; }

.dark .plugin-warning {
  background: rgba(245, 158, 11, 0.1);
  border-color: rgba(245, 158, 11, 0.35);
}

.dark .plugin-warning-text { color: #e8c37a; }

.dark .pron-start-btn {
  box-shadow: 0 16rpx 34rpx rgba(0, 0, 0, 0.45), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.16);
}

.dark .pron-start-hint { color: #9fb8d8; }
